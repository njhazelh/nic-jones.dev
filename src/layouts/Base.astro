---
import '../styles/global.css';
import { profile } from '../data/profile';
import { nav } from '../data/nav';
import { liveSections, isoDay } from '../lib/content';
import { cardPath } from '../lib/og';
import Critters from '../components/Critters.astro';

interface Props {
  title?: string;
  description: string;
  /** Extra JSON-LD for this page */
  jsonLd?: Record<string, unknown>;
  /** Set on blog posts */
  article?: { published: Date; modified?: Date };
  /** Shown only in `npm run dev`: why this page won't be in the production build */
  hiddenBecause?: string | null;
}

const { title, description, jsonLd, article, hiddenBecause } = Astro.props;
const live: Record<string, boolean> = await liveSections();
const items = nav.filter((item) => live[item.href] ?? true);
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name}, ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
// The link-preview card for this page, drawn at build time (src/lib/og.ts).
const ogImage = new URL(`/og/${cardPath(path)}.png`, Astro.site);
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {live['/writing/'] && <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />}
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2427" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={isoDay(article.published)} />}
    {article?.modified && <meta property="article:modified_time" content={isoDay(article.modified)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? profile.pitch} />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header page">
      <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>
        <span class="mark" aria-hidden="true">N</span>{profile.name}
      </a>
      <nav aria-label="Main" class="label">
        <ul>
          {
            items.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    {hiddenBecause && <div class="page"><p class="unpublished label" role="note">{hiddenBecause}: not in the production build.</p></div>}

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer page">
      {
        // The build writes the real numbers here. `npm run dev` has none to show.
        import.meta.env.DEV ? (
          <dl class="readout">
            <div><dt>This page</dt><dd>— KB</dd></div>
            <div><dt>Requests</dt><dd>—</dd></div>
            <div><dt>JavaScript</dt><dd>— KB</dd></div>
            <div><dt>Built in</dt><dd>— s</dd></div>
          </dl>
        ) : (
          <Fragment set:html="<!--page-weight-->" />
        )
      }
      <p class="footnote label">
        <span>Measured from the built files</span>
        <a href="/colophon/">How this site is built</a>
        {profile.links.github && <a href={profile.links.github}>GitHub</a>}
        {live['/writing/'] && <a href="/rss.xml">RSS</a>}
        {/* Hidden until the critters' script shows it, so it never appears without JavaScript */}
        <button type="button" class="critters-toggle" aria-pressed="true" hidden>Critters</button>
      </p>
    </footer>
    <Critters />
  </body>
</html>

<style>
  .site-header {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-block: var(--unit);
    margin-bottom: calc(var(--unit) * 2.5);
  }
  /* A ruler under the header: a hairline with a short tick every 0.75rem and
     a long one every 4.5rem */
  .site-header::after {
    content: '';
    position: absolute;
    inset: auto var(--gutter) 0;
    height: 0.6rem;
    background:
      linear-gradient(var(--rule-strong), var(--rule-strong)) left bottom / 100% 1px no-repeat,
      linear-gradient(90deg, var(--rule-strong) 1px, transparent 1px) left bottom / 4.5rem 0.6rem repeat-x,
      linear-gradient(90deg, var(--rule) 1px, transparent 1px) left bottom / 0.75rem 0.3rem repeat-x;
    pointer-events: none;
  }
  .site-name {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    text-decoration: none;
  }
  .mark {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 3px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 160ms ease;
  }
  .site-name:hover .mark {
    transform: rotate(-6deg);
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem clamp(0.9rem, 3vw, 1.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    display: inline-block;
    padding-block: 0.35rem;
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.55em;
  }
  .site-footer {
    position: relative;
    margin-top: calc(var(--unit) * 4);
    padding-block: calc(var(--unit) * 1.25) calc(var(--unit) * 2);
  }
  .site-footer::before {
    content: '';
    position: absolute;
    inset: 0 var(--gutter) auto;
    border-top: 1px solid var(--rule-strong);
  }
  /* The readout is written into the page after the build
     (integrations/page-weight.mjs), so these styles reach it globally. */
  .site-footer :global(.readout) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: calc(var(--unit) / 2) 1.5rem;
    margin: 0 0 var(--unit);
  }
  .site-footer :global(.readout dt) {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .site-footer :global(.readout dd) {
    margin: 0;
    font-size: var(--step-1);
    font-weight: 600;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .footnote {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    color: var(--fg-muted);
  }
  /* The critters' on/off switch. The words and aria-pressed carry the state;
     the square is a supporting cue. Padding with a matching negative margin
     gives a taller target without changing the line. */
  .critters-toggle {
    padding: 0.35rem 0;
    margin-block: -0.35rem;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    text-decoration: underline var(--accent) 0.08em;
    text-underline-offset: 0.3em;
    cursor: pointer;
  }
  .critters-toggle[hidden] {
    display: none;
  }
  .critters-toggle::before {
    content: '';
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.5em;
    vertical-align: -0.05em;
    border: 1px solid var(--accent);
  }
  .critters-toggle[aria-pressed='true']::before {
    background: var(--accent);
  }
  .critters-toggle:hover {
    color: var(--accent);
  }
  .unpublished {
    margin-bottom: var(--unit);
    padding-block: 0.25rem;
    border-block: 1px dashed var(--accent);
    color: var(--accent);
  }
</style>
