---
import '../styles/global.css';
import { profile } from '../data/profile';
import { nav } from '../data/nav';
import { liveSections, isoDay } from '../lib/content';

interface Props {
  title?: string;
  description: string;
  /** Extra JSON-LD for this page */
  jsonLd?: Record<string, unknown>;
  /** Set on blog posts */
  article?: { published: Date; modified?: Date };
  /** Shown only in `npm run dev`: why this page won't be in the production build */
  hiddenBecause?: string | null;
}

const { title, description, jsonLd, article, hiddenBecause } = Astro.props;
const live: Record<string, boolean> = await liveSections();
const items = nav.filter((item) => live[item.href] ?? true);
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name}, ${profile.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href="/fonts/source-serif-4-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {live['/writing/'] && <link rel="alternate" type="application/rss+xml" title={`${profile.name}: writing`} href="/rss.xml" />}
    <meta name="theme-color" content="#f4efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1d2427" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    {article && <meta property="article:published_time" content={isoDay(article.published)} />}
    {article?.modified && <meta property="article:modified_time" content={isoDay(article.modified)} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header page">
      <a class="site-name" href="/" aria-current={path === '/' ? 'page' : undefined}>{profile.name}</a>
      <nav aria-label="Main">
        <ul>
          {
            items.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
          }
        </ul>
      </nav>
    </header>

    {hiddenBecause && <p class="unpublished page" role="note">{hiddenBecause}: not in the production build.</p>}

    <main id="main" class="page">
      <slot />
    </main>

    <footer class="site-footer page">
      <p>
        <!--page-weight-->
        {' '}<a href="/colophon/">How this site is built</a>.
      </p>
    </footer>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: var(--unit) calc(var(--unit) * 2);
  }
  .site-name {
    font-weight: 600;
    text-decoration: none;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    text-decoration: none;
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .site-footer {
    margin-top: calc(var(--unit) * 3);
    padding-block: var(--unit) calc(var(--unit) * 2);
    border-top: 1px solid var(--rule);
    color: var(--fg-muted);
    font-size: var(--step--1);
  }
  .site-footer p {
    margin: 0;
  }
  .unpublished {
    margin-bottom: var(--unit);
    padding-block: 0.25rem;
    border-block: 1px dashed var(--accent);
    color: var(--accent);
    font-size: var(--step--1);
  }
</style>
