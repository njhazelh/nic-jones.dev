---
// A project: what it is, where to use it, the write-up, and every post about it.
import { render } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import EntryList from '../../components/EntryList.astro';
import { profile } from '../../data/profile';
import { projects, posts, hiddenBecause, hrefFor, STATUS_LABEL, formatDate, isoDay } from '../../lib/content';
import { monthLabel } from '../../lib/time';

export async function getStaticPaths() {
  return (await projects()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasWriteUp = Boolean(entry.body?.trim());
const related = (await posts()).filter((p) => p.data.project?.id === entry.id);
const host = (url: string) => new URL(url).host.replace(/^www\./, '');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': data.url ? 'SoftwareApplication' : 'CreativeWork',
  name: data.title,
  description: data.description,
  ...(data.url && { url: data.url }),
  ...(data.repo && { codeRepository: data.repo }),
  author: { '@type': 'Person', name: profile.fullName, url: profile.site },
  mainEntityOfPage: new URL(hrefFor(entry), Astro.site).href,
};
---

<Base title={data.title} description={data.description} jsonLd={jsonLd} hiddenBecause={hiddenBecause(entry)}>
  <article>
    <header>
      <p class="kicker label">Project</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.description}</p>
      <dl class="facts">
        <dt>Status</dt>
        <dd>{STATUS_LABEL[data.status]}, started {monthLabel(data.started)}</dd>
        {data.stack.length > 0 && (
          <>
            <dt>Built with</dt>
            <dd>{data.stack.join(', ')}</dd>
          </>
        )}
        {data.url && (
          <>
            <dt>Use it</dt>
            <dd><a href={data.url}>{host(data.url)}</a></dd>
          </>
        )}
        {data.repo && (
          <>
            <dt>Source</dt>
            <dd><a href={data.repo}>{host(data.repo)}{new URL(data.repo).pathname}</a></dd>
          </>
        )}
        {data.updated && (
          <>
            <dt>Updated</dt>
            <dd><time datetime={isoDay(data.updated)}>{formatDate(data.updated)}</time></dd>
          </>
        )}
      </dl>
    </header>

    {
      data.screenshot && (
        <figure class="shot">
          <Picture
            src={data.screenshot}
            alt={data.screenshotAlt!}
            formats={['avif', 'webp']}
            widths={[280, 560]}
            sizes="280px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      )
    }

    {
      hasWriteUp && (
        <div class="prose">
          <Content />
        </div>
      )
    }

    {
      related.length > 0 && (
        <section aria-labelledby="writing">
          <h2 id="writing">Writing about {data.title}</h2>
          <EntryList entries={related} />
        </section>
      )
    }
  </article>
</Base>

<style>
  .facts {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 0.4rem 1.5rem;
    padding-block: calc(var(--unit) * 0.75);
    border-block: 1px solid var(--rule-strong);
  }
  .facts dt {
    padding-top: 0.2em;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-muted);
  }
  .facts dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .shot {
    margin: calc(var(--unit) * 1.5) 0;
  }
  .shot :global(img) {
    display: block;
    width: 280px;
    max-width: 100%;
    height: auto;
    border: 1px solid var(--rule-strong);
    border-radius: 6px;
    box-shadow: 0.6rem 0.6rem 0 var(--bg-sunk);
  }
</style>
