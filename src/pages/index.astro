---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import EntryList from '../components/EntryList.astro';
import { fillDurations } from '../lib/time';
import { caseStudies, posts, liveSections } from '../lib/content';

const detail = fillDurations(profile.pitchDetail);

// Chosen by hand, not by date: the home page never shows how long it has been
// since the last post.
const pinnedWork = (await caseStudies()).filter((e) => e.data.pinned).slice(0, 2);
const pinnedPosts = (await posts()).filter((e) => e.data.pinned).slice(0, 2);
const live = await liveSections();
const next = [
  live['/positions/'] && { href: '/positions/', label: 'Positions' },
  live['/work/'] && { href: '/work/', label: 'Work' },
  live['/writing/'] && { href: '/writing/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
].filter(Boolean) as { href: string; label: string }[];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: profile.role,
  url: profile.site,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---

<Base description={`${profile.name}: ${profile.pitch}`} jsonLd={person}>
  <h1 class="pitch">{profile.pitch}</h1>
  <p class="lede">{detail}</p>

  <h2 class="visually-hidden">Proof</h2>
  <ul class="proof" role="list">
    {
      profile.proofPoints.map((p) => (
        <li class={p.figure ? 'has-figure' : undefined}>
          {p.figure && <span class="figure" aria-hidden="true">{p.figure}</span>}
          <span class="claim">{p.claim}</span>
          <span class="detail">{p.detail}</span>
        </li>
      ))
    }
  </ul>

  {
    pinnedWork.length > 0 && (
      <section aria-labelledby="pinned-work">
        <h2 id="pinned-work">Case studies</h2>
        <EntryList entries={pinnedWork} undated />
      </section>
    )
  }
  {
    pinnedPosts.length > 0 && (
      <section aria-labelledby="pinned-writing">
        <h2 id="pinned-writing">Essays</h2>
        <EntryList entries={pinnedPosts} undated />
      </section>
    )
  }

  <p class="next">
    {
      next.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a href={l.href}>{l.label}</a>
        </>
      ))
    }
  </p>
</Base>

<style>
  .pitch {
    font-size: var(--step-2);
    max-width: 22em;
  }
  .lede {
    color: var(--fg-muted);
    margin-bottom: calc(var(--unit) * 2);
  }
  .proof {
    display: grid;
    gap: var(--unit);
    padding: 0;
    list-style: none;
    margin-bottom: calc(var(--unit) * 2);
  }
  .proof li {
    display: grid;
    padding-top: calc(var(--unit) / 2);
    border-top: 1px solid var(--rule);
  }
  .proof li.has-figure {
    grid-template-columns: 4.5rem 1fr;
    column-gap: 1rem;
  }
  .figure {
    grid-row: span 2;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .claim {
    font-weight: 600;
  }
  .has-figure .detail {
    grid-column: 2;
  }
</style>
