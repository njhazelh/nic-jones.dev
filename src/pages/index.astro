---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import EntryList from '../components/EntryList.astro';
import ProjectList from '../components/ProjectList.astro';
import FrameChart from '../components/FrameChart.astro';
import { fillDurations } from '../lib/time';
import { projects, posts, liveSections } from '../lib/content';

const detail = fillDurations(profile.pitchDetail);

// Chosen by hand, not by date: the home page never shows how long it has been
// since the last post.
const pinnedProjects = (await projects()).filter((e) => e.data.pinned).slice(0, 3);
const pinnedPosts = (await posts()).filter((e) => e.data.pinned).slice(0, 2);
const live = await liveSections();
const next = [
  live['/projects/'] && { href: '/projects/', label: 'Projects' },
  live['/writing/'] && { href: '/writing/', label: 'Writing' },
  { href: '/resume/', label: 'Resume' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
].filter(Boolean) as { href: string; label: string }[];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: profile.role,
  url: profile.site,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---

<Base description={`${profile.name}: ${profile.pitch}`} jsonLd={person}>
  <header class="hero wide">
    <p class="kicker label">{profile.role}</p>
    <h1 class="pitch">{profile.pitch}</h1>
  </header>

  <FrameChart class="wide" />

  <p class="lede">{detail}</p>

  <h2 class="visually-hidden">Proof</h2>
  <ul class="proof wide" role="list">
    {
      profile.proofPoints.map((p) => (
        <li>
          {p.figure && <span class="figure" aria-hidden="true">{p.figure}</span>}
          <span class="claim">{p.claim}</span>
          <span class="detail">{p.detail}</span>
        </li>
      ))
    }
  </ul>

  {
    pinnedProjects.length > 0 && (
      <section aria-labelledby="pinned-projects">
        <h2 id="pinned-projects">What I'm building</h2>
        <ProjectList entries={pinnedProjects} />
      </section>
    )
  }
  {
    pinnedPosts.length > 0 && (
      <section aria-labelledby="pinned-writing">
        <h2 id="pinned-writing">Writing</h2>
        <EntryList entries={pinnedPosts} undated />
      </section>
    )
  }

  <nav class="next wide" aria-label="More on this site">
    <ul role="list">
      {
        next.map((l) => (
          <li>
            <a href={l.href}>
              {l.label}
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</Base>

<style>
  .hero .kicker {
    margin-bottom: var(--unit);
  }
  .pitch {
    max-width: 24ch;
    margin-bottom: 0;
    font-size: var(--text-display);
    line-height: 1.06;
    letter-spacing: -0.025em;
  }
  .lede {
    color: var(--fg-muted);
    margin-bottom: calc(var(--unit) * 2);
  }
  .proof {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    margin-bottom: calc(var(--unit) * 2);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }
  .proof li {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: var(--unit) 1.5rem var(--unit) 0;
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 48em) {
    .proof li {
      padding-left: 1.5rem;
      border-bottom: 0;
      border-left: 1px solid var(--rule);
    }
    .proof li:first-child {
      padding-left: 0;
      border-left: 0;
    }
  }
  .proof li::before {
    content: '';
    width: 1.5rem;
    height: 2px;
    margin-bottom: 0.5rem;
    background: var(--accent);
  }
  .figure {
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .claim {
    font-size: var(--step-1);
    font-weight: 600;
    line-height: 1.2;
  }
  .detail {
    font-size: 0.92em;
    line-height: 1.45;
    color: var(--fg-muted);
  }
  .next {
    margin-top: calc(var(--unit) * 3);
  }
  .next ul {
    display: grid;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 48em) {
    .next ul {
      grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    }
  }
  .next a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-block: 0.75rem;
    border-top: 2px solid var(--fg);
    font-size: var(--step-1);
    font-weight: 600;
    text-decoration: none;
  }
  .next a:hover {
    border-top-color: var(--accent);
  }
  .arrow {
    font-family: var(--font-mono);
    font-weight: 400;
    transition: translate 160ms ease;
  }
  .next a:hover .arrow {
    translate: 0.3rem 0;
  }
</style>
