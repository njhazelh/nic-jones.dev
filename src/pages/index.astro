---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';
import { fillDurations } from '../lib/time';

const detail = fillDurations(profile.pitchDetail);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.fullName,
  alternateName: profile.name,
  jobTitle: profile.role,
  url: profile.site,
  sameAs: [profile.links.github, profile.links.linkedin].filter(Boolean),
};
---

<Base description={`${profile.name}: ${profile.pitch}`} jsonLd={person}>
  <h1 class="pitch">{profile.pitch}</h1>
  <p class="lede">{detail}</p>

  <h2 class="visually-hidden">Proof</h2>
  <ul class="proof" role="list">
    {
      profile.proofPoints.map((p) => (
        <li>
          <span class="figure" aria-hidden="true">{p.figure ?? ""}</span>
          <span class="claim">{p.claim}</span>
          <span class="detail">{p.detail}</span>
        </li>
      ))
    }
  </ul>

  <p class="next">
    <a href="/resume/">Resume</a> · <a href="/about/">About</a> · <a href="/contact/">Contact</a>
  </p>
</Base>

<style>
  .pitch {
    font-size: var(--step-2);
    max-width: 22em;
  }
  .lede {
    color: var(--fg-muted);
    margin-bottom: calc(var(--unit) * 2);
  }
  .proof {
    display: grid;
    gap: var(--unit);
    padding: 0;
    list-style: none;
    margin-bottom: calc(var(--unit) * 2);
  }
  .proof li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    column-gap: 1rem;
    padding-top: calc(var(--unit) / 2);
    border-top: 1px solid var(--rule);
  }
  .figure {
    grid-row: span 2;
    font-size: var(--step-3);
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .claim {
    font-weight: 600;
  }
  .detail {
    grid-column: 2;
  }
</style>
